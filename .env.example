# ===== 模型（OpenAI 兼容协议）=====
# 不填 key 会进入「演示模式」：剧本驱动，但终端/浏览器/文件操作都是真实执行
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# DeepSeek V4.1 Flash 的模型名以官方 /models 返回为准，启动日志里会列出可用模型
LLM_MODEL=deepseek-flash
# 单价（每百万 token），用于成本统计和预算；请按你所用模型的官方价格填写
LLM_PRICE_INPUT=2
LLM_PRICE_CACHE_HIT=0.5
LLM_PRICE_OUTPUT=8
LLM_PRICE_CURRENCY=¥
# 预算初始值（0 = 不限），之后可在界面「成本与预算」里修改
BUDGET_DAILY=0
BUDGET_PER_GOAL=0
# 消息推送（也可在界面「规则」里设置）：飞书/企业微信/钉钉群机器人 Webhook
NOTIFY_WEBHOOK=
# 消息里附带的访问地址
PUBLIC_URL=
# 钉钉应用机器人（Stream 模式，群里 @ 它下指令），详见 docs/DINGTALK.md
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 可选：管理员 userId（逗号分隔），也可以在界面「规则」里设置
DINGTALK_ADMINS=
# 单个任务最多步数
AGENT_MAX_STEPS=60

# ===== 服务 =====
PORT=8787
HOST=0.0.0.0
# 部署到服务器时务必设置，访问时用 http://host:8787/?token=xxx
ACCESS_TOKEN=
# Agent 们共享的项目目录（相对项目根目录或绝对路径）
WORKSPACE_DIR=workspace
DATA_DIR=data
# PostgreSQL 数据库连接地址（docker compose up -d 启动本地容器）
DATABASE_URL=postgres://af:af_password@localhost:5433/agent_factory
# 可选：主模型异常或超时时的备用模型
LLM_FALLBACK_MODEL=
# 公司业务配置，对应 company/profiles/<id>.json
COMPANY_PROFILE=software-dev
# 设为 false 可以看到真实弹出的浏览器窗口（仅本机）
BROWSER_HEADLESS=true
